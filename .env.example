# Public Supabase configuration for the ROT Android client.
# Copy this file to `.env` for local development. Never commit `.env` or put service_role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://wlzkooowbanponzaxsvj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud OAuth 2.0 Web Client ID (used by Android Google Sign-In to issue an ID token for Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
